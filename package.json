{
  "name": "class-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --port 3010",
    "build": "vite build",
    "start": "wrangler dev --port 3010",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "test:worker": "npm run build:worker-test && node scripts/verify-worker.mjs",
    "build:worker-test": "wrangler deploy --dry-run --outdir .local/worker-build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
