# 강사 기본 접속 코드는 서버에 반영되어 있습니다. HOST_PASSWORD는 변경 시에만 지정하세요.
HOST_PASSWORD=
# 로컬 세션용. Vercel에서는 비공개 Blob 연결 토큰을 사용하므로 생략할 수 있습니다.
SESSION_SECRET=
# Vercel Storage에서 비공개 Blob 연결 시 자동으로 등록됩니다.
BLOB_READ_WRITE_TOKEN=
# LOCAL_PREVIEW=true는 로컬에서만 사용. Vercel에서는 반드시 비워두세요.
LOCAL_PREVIEW=
# 선택 사항: 공유 이미지의 기준 주소. 미설정 시 Vercel 도메인을 사용합니다.
SITE_URL=
