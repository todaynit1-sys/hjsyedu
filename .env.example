# 로컬에서는 npm run setup:local로 안전한 임시 비밀번호를 만듭니다.
# Vercel에서는 아래 값을 환경변수에 등록하세요. NEXT_PUBLIC_ 접두사는 사용하지 않습니다.
HOST_PASSWORD=
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# LOCAL_PREVIEW=true는 로컬에서만 사용. Vercel에서는 반드시 비워두세요.
LOCAL_PREVIEW=
# 선택 사항: 공유 이미지의 기준 주소. 미설정 시 Vercel 도메인을 사용합니다.
SITE_URL=
